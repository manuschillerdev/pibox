{
  "arch": "aarch64",
  "distro": "alpine",
  "alpine": {
    "version": "3.23.0",
    "kernelPackage": "linux-virt",
    "kernelImage": "vmlinuz-virt",
    "initramfsPackages": [],
    "krunfwVersion": "v5.2.1"
  },
  "oci": {
    "image": "ghcr.io/manuschillerdev/pibox-base:bookworm",
    "runtime": "podman",
    "platform": "linux/arm64",
    "pullPolicy": "always"
  },
  "rootfs": {
    "label": "pibox-root",
    "sizeMb": 4096
  },
  "runtimeDefaults": {
    "rootfsMode": "cow"
  }
}
