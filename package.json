{
  "name": "pibox",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "engines": {
    "node": ">=23.6.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src guest",
    "test": "node --test tests/*.test.mjs"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "dependencies": {
