{
  "name": "pibox",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src guest",
    "test": "node --test tests/*.test.mjs",
    "test:cache": "node tests/cache-deduplication.mjs"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "dependencies": {
    "microsandbox": "0.7.14",
    "portless": "0.17.0",
    "smol-toml": "1.9.1",
    "smolmachines": "1.32.4"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.80.8",
    "@earendil-works/pi-tui": "0.80.8",
    "@eslint/js": "9.39.2",
    "@types/node": "22.19.11",
    "eslint": "9.39.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.54.0"
  }
}
